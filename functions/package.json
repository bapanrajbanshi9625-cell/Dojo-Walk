const { onCall, HttpsError } = require("firebase-functions/v2/https");
const { initializeApp } = require("firebase-admin/app");
const { getAuth } = require("firebase-admin/auth");

initializeApp();

/**
 * MSG91 → Firebase authentication bridge
 *
 * अभी यह सिर्फ Firebase Custom Token generate करने
 * की basic server-side function है.
 *
 * MSG91 validation हम अगले step में जोड़ेंगे.
 */
exports.createFirebaseToken = onCall(async (request) => {
  if (!request.auth) {
    throw new HttpsError(
      "unauthenticated",
      "Authentication is required."
    );
  }

  const uid = request.auth.uid;

  try {
    const customToken = await getAuth().createCustomToken(uid);

    return {
      success: true,
      customToken: customToken,
    };
  } catch (error) {
    console.error("Firebase token creation error:", error);

    throw new HttpsError(
      "internal",
      "Unable to create Firebase authentication token."
    );
  }
});
